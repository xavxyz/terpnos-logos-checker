# Copy to .sandcastle/.env and fill in. This file is git-ignored.
#
# Only credentials the AGENT needs belong here — Sandcastle resolves this file
# when it launches the sandbox. Everything that talks to GitHub runs on the host
# using your own `gh` login, so there is deliberately no GH_TOKEN here.
#
# Never put ASSEMBLYAI_API_KEY or BLOB_READ_WRITE_TOKEN in this file. Those are
# production secrets for the deployed app; they belong in Vercel project
# environment variables, and an autonomous agent has no use for them.

# Claude Code auth. Get one with `claude setup-token` — bills against your
# existing subscription rather than opening a metered API account.
CLAUDE_CODE_OAUTH_TOKEN=

# Vercel Sandbox auth, for creating the microVMs the agents run in.
# `VERCEL_OIDC_TOKEN` is preferred; `VERCEL_TOKEN` works too.
VERCEL_TOKEN=
