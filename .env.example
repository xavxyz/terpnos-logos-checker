# Copy to .env and fill in. This file is git-ignored.
#
# Host-only credentials. `npm run sandcastle` loads this file into the
# orchestrator process on your machine, and nothing forwards it into the
# sandbox: Sandcastle builds the sandbox environment from the keys of
# .sandcastle/.env, so a key that appears only here never reaches the agent.
#
# That is the whole distinction between the two files:
#   .env               — the host needs it, the agent must not have it
#   .sandcastle/.env   — the agent needs it, and it is forwarded into the microVM

# Creates and bills the Vercel Sandbox microVMs the agents run in. The
# orchestrator refuses to start without it, and refuses to start if it finds
# this key in .sandcastle/.env instead.
VERCEL_TOKEN=
