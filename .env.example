# Copy to .env and fill in. This file is git-ignored.
#
# Host-only credentials. `npm run sandcastle` loads this file into the
# orchestrator process on your machine, and nothing forwards it into the
# sandbox: Sandcastle builds the sandbox environment from the keys of
# .sandcastle/.env, so a key that appears only here never reaches the agent.
#
# That is the whole distinction between the two files:
#   .env               — the host needs it, the agent must not have it
#   .sandcastle/.env   — the agent needs it, and it is forwarded into the microVM

# Creates and bills the Vercel Sandbox microVMs the agents run in. All three are
# required together: @vercel/sandbox uses an explicit credential only when it
# has the token, the team ID and the project ID, and with any one of them
# missing it ignores the rest and falls back to OIDC — which on a laptop fails
# with "Could not get credentials from OIDC context".
#
# The orchestrator refuses to start without all three, and refuses to start if
# it finds any of them in .sandcastle/.env instead.
#
# Token:      https://vercel.com/account/settings/tokens
# Team ID:    team settings page, or `npx vercel link` -> .vercel/project.json
# Project ID: project settings page, or the same project.json
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# The application's own variable, read on the server only: the single shared
# password the sophrologist types to open the app. It is never shipped to the
# browser. In production it lives in the Vercel project's environment variables.
SHARED_PASSWORD=

# The Vercel Blob store the browser uploads the recording to. Read on the server
# only: the browser never sees it — it receives a single-use token minted from it
# for one upload. `vercel env pull` writes it locally once a Blob store is linked
# to the project; in production it comes from the Vercel project itself.
BLOB_READ_WRITE_TOKEN=
