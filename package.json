{
  "name": "terpnos-logos-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Comparateur de transcript audio vis-à-vis d'un terpnos logos scripté d'une séance de sophrologie",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sandcastle": "tsx --env-file-if-exists=.env --env-file-if-exists=.sandcastle/.env .sandcastle/main.mts",
    "sandcastle:check": "tsc -p .sandcastle/tsconfig.json"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vercel/sandbox": "^1.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.1.12"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
